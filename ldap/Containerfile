# Containerfile
FROM debian:bookworm

LABEL org.opencontainers.image.source="https://github.com/elaverick/homelab"

ENV DEBIAN_FRONTEND=noninteractive

# Install packages required by slapd and Ansible
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        slapd \
        ldap-utils \
        debconf-utils \
        python3 \
        python3-pip \
        python3-ldap \
        python3-yaml \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Create persistent data directories
RUN mkdir -p \
        /var/lib/ldap \
        /etc/ldap/slapd.d

# Declare the persistent volumes
VOLUME ["/var/lib/ldap", "/etc/ldap/slapd.d"]

# LDAP
EXPOSE 389

# LDAPS (for later)
EXPOSE 636

# Run slapd in the foreground
CMD ["/usr/sbin/slapd", "-h", "ldap:/// ldaps:/// ldapi:///", "-d", "0"]