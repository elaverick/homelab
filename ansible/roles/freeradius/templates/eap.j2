#  EAP module: EAP-TLS only.
#
#  Devices authenticate with a client certificate issued by the homelab
#  Intermediate CA. No password-based or tunnelled EAP methods (PEAP,
#  TTLS, MSCHAPv2, MD5, GTC) are offered; a supplicant proposing one is
#  sent a NAK for EAP-TLS.
#
#  The stock 3.2 module file documents every option in detail. This file
#  deliberately contains only the settings in use.
eap {
	default_eap_type = tls

	timer_expire = 60

	ignore_unknown_eap_types = no

	cisco_accounting_username_bug = no

	max_sessions = ${max_requests}

	tls-config tls-common {
		#  Server certificate presented to supplicants. The PEM bundle
		#  contains the key, leaf certificate and Intermediate CA.
		private_key_file = "{{ freeradius_certificate_path }}"
		certificate_file = "{{ freeradius_certificate_path }}"

		#  Trust anchors for device certificates: Intermediate and Root
		#  CA only. The image's ${cadir} test CA is deliberately not
		#  trusted, so there is no ca_path.
		ca_file = "{{ freeradius_client_ca_path }}"

		cipher_list = "DEFAULT"
		cipher_server_preference = no

		tls_min_version = "{{ freeradius_eap_tls_min_version }}"
		tls_max_version = "{{ freeradius_eap_tls_max_version }}"

		ecdh_curve = ""

		#  Session resumption is disabled so that every authentication
		#  presents a certificate and repeats the directory lookup,
		#  making device disablement and zone changes take effect on the
		#  next association.
		cache {
			enable = no
		}
	}

	tls {
		tls = tls-common

		#  Runs once the certificate chain has been validated. It
		#  checks the certificate is a device certificate, looks the
		#  device up in LDAP, and assigns its VLAN.
		virtual_server = {{ freeradius_device_site_name }}
	}
}
