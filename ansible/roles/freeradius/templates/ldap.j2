#  Device directory lookup.
#
#  Called from the {{ freeradius_device_site_name }} virtual server once the
#  device certificate has been validated. The device is identified by the
#  certificate Common Name, which must match its deviceId. Disabled devices
#  are excluded by the filter, so they are treated as unknown.
#
#  The certificate's serial must also be one the cert-enrolment RA recorded
#  for the device (deviceCertificate values are "<serial hex> <expiry>").
#  Certificates the RA revoked, from a deleted device or an earlier
#  registration of the same name, therefore stop working at once.
#
#  FreeRADIUS never reads passwords from the directory.
ldap {
    server = "{{ freeradius_ldap_server }}"

    identity = "{{ freeradius_bind_dn }}"
    password = "{{ freeradius_bind_password }}"

    base_dn = "{{ ldap_base_dn }}"

    tls {
        ca_file = "{{ freeradius_trust_directory }}/{{ root_certificate }}"
        require_cert = "demand"
        tls_min_version = "1.2"
    }

    update {
        control:Tmp-String-0 := 'deviceZone'
        control:Tmp-String-1 := 'deviceType'
    }

    user {
        base_dn = "{{ freeradius_device_base_dn }}"
        {% raw %}filter = "(&(objectClass=managedDevice)(deviceId=%{TLS-Client-Cert-Common-Name})(!(deviceDisabled=TRUE))(deviceCertificate=%{TLS-Client-Cert-Serial} *))"{% endraw %}

        scope = 'sub'
    }
}
