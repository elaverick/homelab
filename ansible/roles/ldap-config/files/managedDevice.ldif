dn: cn=managedDevice,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: managedDevice
olcAttributeTypes: ( 1.3.6.1.4.1.66636.1.1.2.1
  NAME 'deviceId'
  DESC 'Stable identifier for a managed device enrolment; must match the device certificate CN'
  EQUALITY caseExactMatch
  SUBSTR caseExactSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.66636.1.1.2.2
  NAME 'deviceType'
  DESC 'Broad classification of a managed device'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.66636.1.1.2.3
  NAME 'deviceDisabled'
  DESC 'Indicates that the managed device is administratively disabled'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.66636.1.1.2.4
  NAME 'deviceZone'
  DESC 'Network authorisation zone assigned to the managed device'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.66636.1.1.2.5
  NAME 'deviceCertificate'
  DESC 'A certificate issued to the device: serial number in hex and expiry as GeneralizedTime, separated by a space'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
olcObjectClasses: ( 1.3.6.1.4.1.66636.1.1.1.1
  NAME 'managedDevice'
  DESC 'Managed device with lifecycle metadata and network authorisation'
  SUP top
  AUXILIARY
  MAY ( deviceId $ deviceType $ deviceDisabled $ deviceZone $ deviceCertificate ) )
