---
schema_version: 1
generated_at: "{{ ansible_date_time.iso8601 }}"

host:
  operating_system:
    distribution: "{{ software_inventory_host.operating_system.distribution }}"
    version: "{{ software_inventory_host.operating_system.version }}"
    architecture: "{{ software_inventory_host.operating_system.architecture }}"
  kernel:
    name: "{{ software_inventory_host.kernel.name }}"
    version: "{{ software_inventory_host.kernel.version }}"
  software:
    podman: "{{ software_inventory_host.software.podman }}"
  packages:
{% for package in software_inventory_host.packages %}
    - name: "{{ package.name }}"
      version: "{{ package.version }}"
      architecture: "{{ package.architecture }}"
      status: "{{ package.status }}"
{% endfor %}

containers:
{% for container in software_inventory_containers %}
  - name: "{{ container.name }}"
    id: "{{ container.id }}"
    status: "{{ container.status }}"

    image:
      name: "{{ container.image.name }}"
      id: "{{ container.image.id }}"
      digest: "{{ container.image.digest | default('') }}"
      version: "{{ container.image.version | default('') }}"
      revision: "{{ container.image.revision | default('') }}"

    operating_system:
      id: "{{ container.operating_system.id }}"
      id_like: "{{ container.operating_system.id_like }}"
      name: "{{ container.operating_system.name }}"

    package_manager: "{{ container.package_manager }}"

    packages:
{% for package in container.packages %}
      - name: "{{ package.name }}"
        version: "{{ package.version }}"
{% if package.architecture is defined %}
        architecture: "{{ package.architecture }}"
{% endif %}
{% if package.status is defined %}
        status: "{{ package.status }}"
{% endif %}
{% endfor %}
{% endfor %}

